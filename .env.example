# Copia este archivo a .env (o exporta las variables) para correr en local.
# Sin GEMINI_API_KEY el sistema funciona en modo mock determinista: no llama
# a ninguna API y usa embeddings/respuestas falsas pero estables. Ideal para
# desarrollar y correr los tests.

# Token de Gemini (te lo da el facilitador). En Render se pega al crear el Blueprint.
GEMINI_API_KEY=

# Fuerza el modo mock aunque haya API key (útil si Gemini devuelve 429 en vivo).
# AGENT_MODEL=mock

# Modelos (defaults razonables; no hace falta tocarlos).
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Conexión a Postgres. Sin ella, todo vive en memoria (RAG incluido).
# En Render la inyecta el Blueprint automáticamente.
# DATABASE_URL=postgresql://user:pass@localhost:5432/support_agent

# Puerto del servidor (default 3000).
# PORT=3000
